{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Academic Events by Course",
  "data": {
    "url": "http://127.0.0.1:8000/api/events/",
    "format": {
      "type": "json",
      "property": "results"
    }
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "course",
      "type": "nominal",
      "title": "Course"
    },
    "y": {
      "aggregate": "count",
      "title": "Number of Events"
    }
  }
}